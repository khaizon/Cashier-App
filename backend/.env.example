# Copy to backend/.env and fill in.

# REQUIRED outside localhost: long random string used to sign JWTs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CASHIER_SECRET_KEY=change-me-to-a-long-random-string

# SQLite file, relative to the backend/ directory.
CASHIER_DATABASE_URL=sqlite:///./data/cashier.db

# Token lifetime in minutes (default 720 = 12 hours).
CASHIER_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated browser origins allowed to call the API.
CASHIER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
